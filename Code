#define ledPin 4

void setup() {
  // put your setup code here, to run once:
  pinMode(ledPin, OUTPUT);
  digitalWrite(ledPin, HIGH);  // สั่งให้ LED ติด

  Serial.begin(115200);
  Serial.println("Hello, ESP32!");
}

void loop() {
  digitalWrite(ledPin, HIGH);
  delay(500);
  digitalWrite(ledPin, LOW);
  delay(500);
}
